# Backend Environment Variables
# LOCAL DEV: Set secrets here in .env file
# PRODUCTION: Secrets are loaded from Google Secret Manager via Cloud Run

# Required for Vertex AI / Gemini
PROJECT_ID="test-rag-corpus-project"
FIREBASE_PROJECT_ID="sensei-ask-project"
LOCATION="us-west1"

# Optional: shared RAG corpus (unused in v1 — the Skill is embedded in the
# system prompt, and reviews always report review_basis=standard_positions)
RAG_CORPUS="projects/test-rag-corpus-project/locations/us-west1/ragCorpora/137359788634800128"

# Optional: frontend base URL used in feedback notification emails
APP_BASE_URL="https://www.scmsensei.ai"

# SMTP for external-feedback owner notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="muhammad@scmdojo.com"
SMTP_FROM="Sensei Support <muhammad@scmdojo.com>"
